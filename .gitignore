# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
playwright/.auth/
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build

# openwiki (auto-generated docs)
/openwiki

# local-only files
/AGENTS.md
/resume.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
# .env.test is intentionally tracked — contains only test placeholders, no secrets

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# the dependency tree nuke-and-migrate leaves behind; not part of the project
.nm-old-trash/

# Python bytecode from the §10.8 fixture
__pycache__/
*.pyc

# the deployment environment (holds a database password) - never committed
/coolify.env
