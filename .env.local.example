# The application's environment.
#
# Copy this file to `.env.local` and fill it in. Every variable the
# application reads is here, and nothing that it does not read is.
#
# **Build-time and runtime.** The `NEXT_PUBLIC_*` variables are inlined by
# Next.js when the application is built: changing one means a new build,
# not a restart. Everything else is read when the application runs.

# --- The application's own address ---

# Build-time. The base URL the application builds its join links and its
# invitation links against. It has to be the address the application is
# actually reached at, or the links it sends point somewhere else.
#
# Upgrading from BETTER_AUTH_URL: that variable is no longer read. Set
# NEXT_PUBLIC_APP_URL and rebuild, or the links fall back to localhost.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# --- The database ---

# Runtime. The PostgreSQL connection string. **Set it to the non-owner
# role** — the one the migrations create — and the row-level security
# policies apply to the application. A connection as the owner, or as a
# role with BYPASSRLS, sees every row whatever the policies say, and the
# household isolation falls back on the application alone.
#
# The `sslmode` is not the same for every server and every tool. Against
# the Supabase pooler the mode is `?sslmode=verify-full`, and the
# deployment points `NODE_EXTRA_CA_CERTS` at Supabase's root certificate:
# the pooler's certificate chains to it, and nothing else on the system
# trusts it, so without the file the connection is refused with "self-signed
# certificate in certificate chain". The certificate is in the repository at
# `deploy/prod-ca-2021.crt` — Supabase's root certificate, the file the
# dashboard offers under Project Settings -> Database -> SSL Configuration —
# and it is a public trust anchor, not a secret. Node reads
# `NODE_EXTRA_CA_CERTS` when it starts, so the deployment sets it and the
# connection string carries no path.
#
# `psql` is told the same certificate its own way: `?sslmode=verify-full`
# with `sslrootcert` pointing at that file. `sslrootcert=system` does not
# help — the system's roots do not carry Supabase's.
#
# A deployment that cannot carry the file can use `?sslmode=no-verify`,
# which encrypts the traffic without authenticating the pooler. Against a
# local database there is no mode at all: the local PostgreSQL offers no
# TLS, so both `verify-full` and `require` are refused, and the connection
# string that connects is the one with no mode.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# --- Supabase Auth ---

# Build-time. The Supabase project's URL: the API the application
# authenticates against.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Build-time. The publishable key. It is public by design — it is the key
# the browser is allowed to use — and it authorises as that key and nothing
# more.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Runtime, and secret. The service-role key **bypasses row-level
# security**: it sees every row, whatever the policies say. The
# transitional sign-in needs it to provision and re-key accounts (§13.2c),
# and the admin console needs it to list the users. It must never reach a
# browser, and it must never be committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email ---

# Runtime. The Resend key, for the invitation email. The invitation is
# written to the database as well, so a missing key does not break the
# invitation — it only stops the email going out.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Runtime. The address the invitation email comes from.
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Optional ---

# Runtime. The address allowed to open the admin console. Without it, the
# admin console is closed to everybody.
ADMIN_EMAIL=you@yourdomain.com
