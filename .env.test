# The test environment. Loaded by vitest.config.ts and playwright.config.ts.
#
# dotenv does NOT override a variable that is already set, so these are
# fallbacks: CI's explicit environment variables win over this file, and the
# CI service container stays authoritative.
#
# Playwright's webServer inherits the parent process's environment, so
# everything here reaches the `next dev` the web server starts.

# The local PostgreSQL. The user and password are the same ones the CI
# service container uses (.github/workflows/perf-audit.yml) - the driver
# connects over TCP, and without a role it fails with 28000.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopping_test

# The base URL the application builds its join links and its invitation
# links against. The same value the fallback would give, set explicitly so
# that the fallback is a choice rather than an accident.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend, for the invitation email. There is no key here on purpose: with no
# key the mail is skipped, the invitation row is written, and the invitation
# can be accepted from the link the caller is given. A placeholder key is
# worse than none - the mail is sent, the provider refuses it, the route
# throws, and the invitation is never written at all. A job that needs a key
# asks for one.
RESEND_FROM_EMAIL=noreply@example.com

TEST_PASSWORD=TestPassword123!

# TEST_EMAIL is deliberately NOT set. e2e/auth.setup.ts falls back to a
# unique email per run, and a fixed one makes the sign-up fail on a
# persistent database the second time it runs - the setup has no sign-in
# path for an existing user, so the whole dependent project is skipped.
# Set TEST_EMAIL in the environment only if you are deliberately running
# against a database you have just reset.
